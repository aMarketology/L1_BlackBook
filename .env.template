# ============================================================================
# BlackBook L1 — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in all REQUIRED values before deploying.
#
#   cp .env.template .env
#
# .env is in .gitignore — it must NEVER be committed to git.
# On Hetzner: scp .env root@<SERVER_IP>:/opt/blackbook/.env
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Node will fail to start securely without these
# ─────────────────────────────────────────────────────────────────────────────

# Master encryption key for Shard B (Shamir SSS wallets).
# Encrypts all user Shard B data stored in ReDB.
# MUST be 32+ random bytes — generate with: openssl rand -hex 32
# WARNING: If this changes, ALL existing SSS wallets are permanently bricked.
SERVER_MASTER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ESCROW — Required for L2 settlement to be operational
# ─────────────────────────────────────────────────────────────────────────────

# Ed25519 public key of the L2 sequencer, hex-encoded (64 chars / 32 bytes).
# This is the ONLY key authorised to submit state roots to the escrow vault.
# Generate the L2 sequencer keypair with:  node -e "const {BlackBookKeypair}=require('./sdk/agents_sdk'); BlackBookKeypair.generate().then(k=>console.log(k.toJSON()))"
# Set this to the public_key_hex from that output.
L2_SEQUENCER_PUBKEY=

# ─────────────────────────────────────────────────────────────────────────────
# USDC SPL TOKEN (optional — USDC endpoints are disabled if not set)
# ─────────────────────────────────────────────────────────────────────────────

# Base58-encoded wallet address that has USDC mint authority.
# Create a wallet via POST /wallet/create first, then set its address here.
# On first launch, leave empty. After you create the mint authority wallet,
# add its address here and restart the container.
USDC_MINT_AUTHORITY=

# ─────────────────────────────────────────────────────────────────────────────
# NODE CONFIG
# ─────────────────────────────────────────────────────────────────────────────

# Rust log levels: error | warn | info | debug | trace
# Keep info in production. Use debug only when diagnosing issues.
RUST_LOG=info,layer1=info,tower_http=warn

# Full Rust backtraces in crash logs (1 = enabled, 0 = disabled)
RUST_BACKTRACE=1

# Path to ReDB database file inside the container.
# Mapped to the Docker volume: blackbook-data:/data
REDB_PATH=/data/blockchain_data/blockchain.redb

# ─────────────────────────────────────────────────────────────────────────────
# NETWORK (leave defaults unless running multiple nodes)
# ─────────────────────────────────────────────────────────────────────────────

# HTTP API port (Axum / wallet / escrow endpoints)
# HTTP_PORT=8080

# Solana JSON-RPC port (Phantom, OneKey compatible)
# RPC_PORT=8899

# gRPC relay port (writer → reader node streaming)
# GRPC_PORT=50051

# Node identity (validator ID — unique per node)
# IDENTITY=blackbook-node-1

# Node mode: writer (produces blocks) | reader (syncs from writer)
# MODE=writer

# ─────────────────────────────────────────────────────────────────────────────
# GENESIS SEEDS — Idempotent wallet seeding at startup
# ─────────────────────────────────────────────────────────────────────────────
# Format: comma-separated "address:lamports" pairs.
# 1 BB = 100,000 lamports.  Common amounts:
#   1,000 BB =   100,000,000 lamports
#  10,000 BB = 1,000,000,000 lamports
#  50,000 BB = 5,000,000,000 lamports
#
# A wallet is only seeded if its CURRENT balance is 0 (safe to restart).
# ALL nodes (writer + readers) should carry the same GENESIS_SEEDS so their
# initial state is identical before block-replication begins.
#
# Known PDA addresses (deterministic — no private key):
#   House Treasury  (SHA256 "bb_house_treasury_v1") = FHLDZvGVq8doU4sKAfQ6nCMr8azkEpucCwk1L1jNJAmy
#   Swap Pool       (SHA256 "bb_swap_pool_v1")       = FSqVLDUv2JP6q4GKDUiD7suEWWUcxRp3Fgna8L5FRdGb
#   MAXX Curve      (SHA256 "bb_maxx_curve_v1")      = 51oBZ3eP87zzq9N8uLuqY65DiuGcmR6xSPaaxm9Bun2s
#
GENESIS_SEEDS=EJYsHB4zZ5J5fmtk61Ge9BYDuA1QMtC8j9Dm7q8jWbmo:1000000000,FHLDZvGVq8doU4sKAfQ6nCMr8azkEpucCwk1L1jNJAmy:5000000000

# ─────────────────────────────────────────────────────────────────────────────
# DEALER (optional — swap / withdrawal gateway disabled if not set)
# ─────────────────────────────────────────────────────────────────────────────

# 32-byte Ed25519 private key (hex, 64 chars) for the Dealer wallet.
# The Dealer facilitates BB↔wUSDT swaps and outbound withdrawals.
# Generate with: node -e "const {BlackBookKeypair}=require('./sdk/wallet.sdk'); BlackBookKeypair.generate().then(k=>console.log(k.privateKeyHex))"
DEALER_PRIVATE_KEY=
