# ── Solana ───────────────────────────────────────────────────────────────────
# JSON-RPC endpoint. Use a dedicated provider (Helius, QuickNode) in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional fallback RPC (used when primary fails 3 consecutive times)
# SOLANA_RPC_FALLBACK_URL=https://rpc.helius.xyz/?api-key=XXX

# ── Custody wallet ────────────────────────────────────────────────────────────
# The Solana address that receives USDC/USDT from on-ramp users.
# This is read-only — the watcher never holds keys or signs Solana txs.
CUSTODY_WALLET=GTvWn5tvMukS4uJxik8nSszuYF27642kJSwtbkKBcgUB

# ── Assets ───────────────────────────────────────────────────────────────────
# Comma-separated list of SPL mint addresses the watcher cares about.
# Mainnet defaults shown; override with devnet mints for testing.
WATCHED_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# Human-readable labels matching the order of WATCHED_MINTS
MINT_LABELS=USDC,USDT

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to poll Solana for new signatures (milliseconds)
POLL_INTERVAL_MS=3000
# How many signatures to fetch per page (max 1000)
POLL_PAGE_SIZE=50
# Reconciler sweep interval (milliseconds) — re-drives stuck items
RECONCILE_INTERVAL_MS=30000
# Max exponential-backoff ceiling for L1 retries (milliseconds)
MAX_BACKOFF_MS=60000

# ── Dust filter ───────────────────────────────────────────────────────────────
# Deposits below this threshold (in micro-units, i.e. 1 USDC = 1_000_000) are
# logged as Ignored(dust) and never submitted to L1.
MIN_DEPOSIT_MICRO=1000000

# ── L1 node ───────────────────────────────────────────────────────────────────
L1_URL=https://layer1.blackbook.id
# Timeout for each L1 HTTP call (milliseconds)
L1_TIMEOUT_MS=10000

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3400

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/bridge.db

# ── Logging ───────────────────────────────────────────────────────────────────
# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ── Backfill ─────────────────────────────────────────────────────────────────
# Optional: set to a known Solana signature to start scanning from that point
# in history (instead of the wallet's most recent tx). Leave blank for live-only.
# BRIDGE_GENESIS_SIGNATURE=
