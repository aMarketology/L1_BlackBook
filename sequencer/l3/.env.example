# L3 NFT Sequencer — required environment variables

# BlackBook L1 endpoints
L1_HTTP_URL=http://91.98.196.34:8080
L1_WS_URL=ws://91.98.196.34:8080/ws

# Sequencer keypair — must match L3_SEQUENCER_PUBKEY on L1
L3_SEQUENCER_PRIVKEY=<64-char hex>
L3_SEQUENCER_PUBKEY=<64-char hex>

# SQLite path (relative to working directory)
DB_PATH=./data/l3.sqlite

# HTTP port (default 7073)
PORT=7073

# Seal a Merkle batch every N L1 slots (default 25)
SLOTS_PER_BATCH=25
