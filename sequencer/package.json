{
  "name": "blackbook-sequencer",
  "private": true,
  "workspaces": ["shared", "l2", "l3", "l5", "bridge-watcher"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:l2": "npm run dev --workspace=l2",
    "dev:l3": "npm run dev --workspace=l3",
    "dev:l5": "npm run dev --workspace=l5",
    "dev:bridge": "npm run build --workspace=bridge-watcher && npm run start --workspace=bridge-watcher"
  }
}
