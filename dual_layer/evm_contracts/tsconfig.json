{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "esModuleInterop":   true,
    "strict":            true,
    "outDir":            "./dist",
    "rootDir":           ".",
    "resolveJsonModule": true,
    "skipLibCheck":      true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./hardhat.config.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
    "./typechain-types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
