# ── BSC Chain Deployment ──────────────────────────────────────────────────────

# Private key of the BSC wallet used to deploy the contract
# (fund this with a small amount of BNB for gas)
BSC_DEPLOYER_PRIVATE_KEY=

# Private key of the BSC operator wallet (the L1 relayer hot key)
# Used to call ackDeposit() and releaseWithdrawal()
# Can be the same as BSC_DEPLOYER_PRIVATE_KEY for testnet
BSC_OPERATOR_PRIVATE_KEY=

# BSC RPC endpoint (BSC dataseed is free; swap for Ankr/Alchemy for production)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Fill this in AFTER deploying the contract:
#   cd evm_contracts && npm install && npm run deploy:testnet
BSC_BRIDGE_CONTRACT=

# BSCScan API key (for contract verification — free at bscscan.com/myapikey)
BSCSCAN_API_KEY=

# URL of your running BlackBook L1 API server (for the relayer)
L1_API_URL=http://localhost:8080
