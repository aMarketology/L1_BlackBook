# BlackBook L1 — Turbine Validator Registry (Phase 7A)
#
# Copy this file to config.toml and populate with your approved validator nodes.
# Alternatively, set the APPROVED_VALIDATORS env var to replace this file entirely.
#
# APPROVED_VALIDATORS format:
#   "label:pubkey_hex@ip:port;pubkey_hex@ip:port"
#   (label is optional — bare "pubkey_hex@ip:port" is also accepted)
#
# Rules:
#   - pubkey must be 64 lowercase hex characters (32-byte Ed25519 public key)
#   - addr must be a valid UDP SocketAddr (ip:port)
#   - Duplicate pubkeys are silently skipped
#   - Unknown source IPs are dropped at the socket layer (no deserialization)
#
# The writer's OWN pubkey (logged at startup as "Turbine identity: pubkey=...")
# MUST appear in this list so reader nodes can verify its signed shreds.
#
# VALIDATOR_KEYPAIR_PATH: path to a file containing the Ed25519 signing key
#   - 64 hex chars (32-byte seed) — preferred
#   - Or 32 raw bytes
#   - If unset, an ephemeral key is generated (dev mode only)

[[validators]]
label  = "genesis-writer"
pubkey = "REPLACE_WITH_64_HEX_CHAR_WRITER_PUBKEY"
addr   = "91.98.196.34:8004"

# Add reader nodes below:
# [[validators]]
# label  = "reader-eu-1"
# pubkey = "REPLACE_WITH_64_HEX_CHAR_READER_PUBKEY"
# addr   = "10.0.0.2:8004"
